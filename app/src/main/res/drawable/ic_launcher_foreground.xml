<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground for the adaptive icon. The 108x108 viewport is required by the
  spec; the inner ~66x66 region is the safe zone (anything outside may be
  cropped to a circle/squircle by the launcher mask).

  Visual: a simplified bike-cog silhouette with a heart-rate sparkline
  threading through it — Peek's reason for existing in one glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cog body, 8 teeth, centered at (54,54) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,28
                          L58,28 L60,34 L66,32 L70,38
                          L76,40 L74,46 L80,50 L80,58
                          L74,62 L76,68 L70,70 L66,76
                          L60,74 L58,80 L50,80
                          L48,74 L42,76 L38,70 L32,68
                          L34,62 L28,58 L28,50
                          L34,46 L32,40 L38,38 L42,32
                          L48,34 L50,28 Z" />

    <!-- Inner negative-space (looks like cog hub) -->
    <path
        android:fillColor="#1E3A5F"
        android:pathData="M54,42 m-9,0 a9,9 0,1 1,18 0 a9,9 0,1 1,-18 0" />

    <!-- Heart-rate sparkline crossing through the hub -->
    <path
        android:strokeColor="#FF6B6B"
        android:strokeWidth="2.4"
        android:fillColor="#00000000"
        android:pathData="M30,54 L42,54 L46,46 L52,62 L58,42 L64,58 L68,54 L78,54" />
</vector>
